# Copy this file to .env and adjust values if needed.
# Default values work out of the box for local development.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etl_db
POSTGRES_PORT=5432
AIRFLOW_DB=airflow_db

# ── Apache Airflow ───────────────────────────────────────────────────────────
# Fernet key encrypts sensitive data in the Airflow DB.
# Generate a new one for production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW_SECRET_KEY=dev_airflow_webserver_secret_key_replace_me!
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# ── Apache Superset ──────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=dev_superset_secret_key_replace_in_production!
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# ── Synthea ──────────────────────────────────────────────────────────────────
SYNTHEA_POPULATION=100
SYNTHEA_SEED=12345
SYNTHEA_SEED_2=12346
SYNTHEA_STATE_1=Massachusetts
SYNTHEA_STATE_2=California

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Max number of patient FHIR files to parse (0 = no limit)
FHIR_LIMIT=100
