# Normalize line endings to LF on commit across all platforms
* text=auto

*.sql  text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.env* text eol=lf

# Binaries — no line ending conversion
*.jar  binary
*.zip  binary
*.png  binary
*.jpg  binary
