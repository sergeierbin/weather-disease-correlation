    DIM_DATE ||--o{ FACT_WEATHER_REGION_DAY : on
    DIM_REGION ||--o{ FACT_WEATHER_REGION_DAY : in
    DIM_WEATHER_TYPE ||--o{ FACT_WEATHER_REGION_DAY : classified_by

    DIM_PATIENT ||--o{ FACT_PATIENT_WEATHER_REGION : has
